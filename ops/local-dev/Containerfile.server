FROM golang:1.26-bookworm AS build

WORKDIR /src
COPY apps/iroha-core/go.mod ./apps/iroha-core/
COPY apps/iroha-imports/go.mod ./apps/iroha-imports/
COPY apps/iroha-providers/go.mod ./apps/iroha-providers/
COPY apps/iroha-runtime/go.mod apps/iroha-runtime/go.sum ./apps/iroha-runtime/
COPY apps/iroha-server/go.mod apps/iroha-server/go.sum ./apps/iroha-server/
COPY apps/iroha-job/go.mod apps/iroha-job/go.sum ./apps/iroha-job/
RUN go -C apps/iroha-server mod download && go -C apps/iroha-job mod download

COPY apps/iroha-core ./apps/iroha-core
COPY apps/iroha-imports ./apps/iroha-imports
COPY apps/iroha-providers ./apps/iroha-providers
COPY apps/iroha-runtime ./apps/iroha-runtime
COPY apps/iroha-server ./apps/iroha-server
COPY apps/iroha-job ./apps/iroha-job
RUN CGO_ENABLED=0 go -C apps/iroha-server build -mod=mod -o /out/iroha-server ./cmd/iroha-server
RUN CGO_ENABLED=0 go -C apps/iroha-job build -mod=mod -o /out/iroha-job .

FROM debian:bookworm-slim AS server
# CA certs are required for outbound HTTPS (e.g. Nominatim geocoding).
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates \
  && rm -rf /var/lib/apt/lists/* \
  && groupadd -r iroha && useradd -r -g iroha -d /data iroha \
  && mkdir -p /data && chown iroha:iroha /data
COPY --from=build /out/iroha-server /usr/local/bin/iroha-server
USER iroha
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/iroha-server"]

FROM debian:bookworm-slim AS job
# CA certs are required for outbound HTTPS (AniList/Bangumi media sync).
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates \
  && rm -rf /var/lib/apt/lists/* \
  && groupadd -r iroha && useradd -r -g iroha -d /data iroha \
  && mkdir -p /data && chown iroha:iroha /data
COPY --from=build /out/iroha-job /usr/local/bin/iroha-job
USER iroha
ENTRYPOINT ["/usr/local/bin/iroha-job"]

FROM golang:1.26-bookworm AS goose
RUN go install github.com/pressly/goose/v3/cmd/goose@v3.27.2

# Standalone migration runner image: run as a k8s Job/initContainer ahead of
# the server rollout. Reads DATABASE_URL or IROHA_DATABASE_URL, same as
# scripts/db.py, and defaults to the "up" action.
FROM debian:bookworm-slim AS migrate
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates \
  && rm -rf /var/lib/apt/lists/* \
  && groupadd -r iroha && useradd -r -g iroha iroha
COPY --from=goose /go/bin/goose /usr/local/bin/goose
COPY apps/iroha-server/db/migrations /migrations
COPY ops/local-dev/migrate-entrypoint.sh /usr/local/bin/migrate-entrypoint.sh
RUN chmod +x /usr/local/bin/migrate-entrypoint.sh
USER iroha
ENTRYPOINT ["/usr/local/bin/migrate-entrypoint.sh"]
CMD ["up"]
