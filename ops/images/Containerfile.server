FROM golang:1.26-bookworm AS build

WORKDIR /src
COPY apps/iroha-core/go.mod ./apps/iroha-core/
COPY apps/iroha-imports/go.mod ./apps/iroha-imports/
COPY apps/iroha-providers/go.mod ./apps/iroha-providers/
COPY apps/iroha-runtime/go.mod apps/iroha-runtime/go.sum ./apps/iroha-runtime/
COPY apps/iroha-server/go.mod apps/iroha-server/go.sum ./apps/iroha-server/
COPY apps/iroha-job/go.mod apps/iroha-job/go.sum ./apps/iroha-job/
RUN go -C apps/iroha-server mod download && go -C apps/iroha-job mod download

COPY apps/iroha-core ./apps/iroha-core
COPY apps/iroha-imports ./apps/iroha-imports
COPY apps/iroha-providers ./apps/iroha-providers
COPY apps/iroha-runtime ./apps/iroha-runtime
COPY apps/iroha-server ./apps/iroha-server
COPY apps/iroha-job ./apps/iroha-job
RUN CGO_ENABLED=0 go -C apps/iroha-server build -mod=mod -o /out/iroha-server ./cmd/iroha-server
RUN CGO_ENABLED=0 go -C apps/iroha-server build -mod=mod -o /out/iroha-export-public ./cmd/iroha-export-public
RUN CGO_ENABLED=0 go -C apps/iroha-job build -mod=mod -o /out/iroha-job .

FROM alpine:3.22 AS server
# ca-certificates is required for outbound HTTPS (e.g. Nominatim geocoding);
# tzdata is required for explicit IANA report timezones in the Alpine runtime.
# tini is PID 1 so signals reach the Go process and no zombies accumulate.
RUN apk add --no-cache ca-certificates tini tzdata \
  && addgroup -S iroha && adduser -S -G iroha -H -h /data iroha \
  && mkdir -p /data && chown iroha:iroha /data
COPY --from=build /out/iroha-server /usr/local/bin/iroha-server
USER iroha
EXPOSE 8080
ENTRYPOINT ["/sbin/tini", "--", "/usr/local/bin/iroha-server"]

FROM alpine:3.22 AS job
# ca-certificates is required for outbound HTTPS (AniList/Bangumi media sync);
# tzdata keeps worker-side calendar/time handling consistent with the server.
RUN apk add --no-cache ca-certificates tini tzdata \
  && addgroup -S iroha && adduser -S -G iroha -H -h /data iroha \
  && mkdir -p /data && chown iroha:iroha /data
COPY --from=build /out/iroha-job /usr/local/bin/iroha-job
USER iroha
ENTRYPOINT ["/sbin/tini", "--", "/usr/local/bin/iroha-job"]

FROM golang:1.26-bookworm AS goose
RUN CGO_ENABLED=0 go install github.com/pressly/goose/v3/cmd/goose@v3.27.2

# Standalone migration runner image: run as a k8s Job/initContainer ahead of
# the server rollout. Reads DATABASE_URL or IROHA_DATABASE_URL, same as
# scripts/db.py, and defaults to the "up" action.
FROM alpine:3.22 AS db-migrate
RUN apk add --no-cache ca-certificates tini \
  && addgroup -S iroha && adduser -S -G iroha iroha
COPY --from=goose /go/bin/goose /usr/local/bin/goose
COPY apps/iroha-server/db/migrations /migrations
COPY ops/images/db-migrate-entrypoint.sh /usr/local/bin/db-migrate-entrypoint.sh
RUN chmod +x /usr/local/bin/db-migrate-entrypoint.sh
USER iroha
ENTRYPOINT ["/sbin/tini", "--", "/usr/local/bin/db-migrate-entrypoint.sh"]
CMD ["up"]

# Batch job image for the k3s CronJob that keeps the public GitHub Pages site
# fresh: exports sanitized data from the in-cluster Postgres and pushes it,
# from inside the private network, to the repo the Pages deploy workflow
# watches. git (not needed by the other images) is the only extra package;
# tzdata is required for the CronJob's Asia/Tokyo schedule check.
FROM alpine:3.22 AS export-public
RUN apk add --no-cache ca-certificates tini git tzdata \
  && addgroup -S iroha && adduser -S -G iroha iroha
COPY --from=build /out/iroha-export-public /usr/local/bin/iroha-export-public
COPY ops/scripts/export-public-cron.sh /usr/local/bin/export-public-cron.sh
RUN chmod +x /usr/local/bin/export-public-cron.sh
USER iroha
ENTRYPOINT ["/sbin/tini", "--", "/usr/local/bin/export-public-cron.sh"]
