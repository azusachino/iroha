{
	# No admin API: the config is static, so nothing needs to change it live.
	admin off
}

# Unprivileged port: the container runs as a non-root user.
:8080 {
	root * /srv
	encode gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Content-Security-Policy "frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
		-Server
	}

	# Hashed build output never changes under its name; everything else,
	# including index.html and API responses that set no policy, is revalidated.
	header ?Cache-Control "no-cache"
	@immutable path /_app/immutable/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	handle /api/* {
		reverse_proxy {$IROHA_SERVER_UPSTREAM}
	}

	handle {
		try_files {path} /index.html
		file_server
	}
}
