FROM oven/bun:1.3.13 AS build

WORKDIR /app
COPY apps/iroha-web/package.json apps/iroha-web/bun.lock ./apps/iroha-web/
WORKDIR /app/apps/iroha-web
RUN bun install --frozen-lockfile
WORKDIR /app
COPY apps/iroha-web ./apps/iroha-web
COPY packages/iroha-shared ./packages/iroha-shared
WORKDIR /app/apps/iroha-web
ARG PUBLIC_IROHA_API_BASE=
ENV PUBLIC_IROHA_API_BASE=$PUBLIC_IROHA_API_BASE
ARG PUBLIC_IROHA_VERSION=dev
ENV PUBLIC_IROHA_VERSION=$PUBLIC_IROHA_VERSION
RUN bun run build

FROM caddy:2-alpine
COPY ops/images/Caddyfile /etc/caddy/Caddyfile
COPY --from=build /app/apps/iroha-web/build /srv
EXPOSE 80
