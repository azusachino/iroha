{
	# No admin API: the config is static.
	admin off
}

# Unprivileged port: the container runs as a non-root user.
:8080 {
	root * /srv
	encode gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Content-Security-Policy "frame-ancestors 'none'; base-uri 'self'; form-action 'none'; object-src 'none'"
		-Server
	}

	# Only the anonymous public API is proxied; the private /api/v1 is not
	# reachable through this site.
	handle /public/v1/* {
		reverse_proxy {$IROHA_SERVER_UPSTREAM}
	}

	# The site is a single page at /; send any other missing path there.
	handle {
		@missing {
			not path /
			not file {
				try_files {path} {path}.html
			}
		}
		redir @missing / 302
		file_server
	}
}
