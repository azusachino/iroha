# Public site: a static client shell that reads the live, sanitized
# projection from iroha-server's anonymous /public/v1 API (ADR-0008).
FROM oven/bun:latest AS build

WORKDIR /app
COPY package.json bun.lock ./
COPY apps/iroha-web ./apps/iroha-web
COPY apps/iroha-public-site ./apps/iroha-public-site
COPY packages/iroha-shared ./packages/iroha-shared
RUN bun install --frozen-lockfile
COPY VERSION ./VERSION
WORKDIR /app/apps/iroha-public-site
# Never bake a local data snapshot into the image; data comes from the API.
RUN rm -rf .svelte-kit build static/data \
  && VITE_IROHA_VERSION="$(cat /app/VERSION)" bun run build

FROM caddy:2-alpine AS public-site
ARG SOURCE_REVISION
RUN test -n "$SOURCE_REVISION"
LABEL org.opencontainers.image.revision=$SOURCE_REVISION
COPY ops/images/Caddyfile.public-site /etc/caddy/Caddyfile
COPY --from=build /app/apps/iroha-public-site/build /srv
# Run unprivileged; /data and /config are Caddy's writable state directories.
# Re-copy the binary to drop its cap_net_bind_service file capability: it is
# unneeded on :8080, and the kernel refuses to exec a file-capability binary
# once Kubernetes drops all capabilities with no privilege escalation.
RUN addgroup -S iroha && adduser -S -G iroha -H iroha \
  && chown -R iroha:iroha /data /config \
  && cp /usr/bin/caddy /usr/bin/caddy.nocap && mv /usr/bin/caddy.nocap /usr/bin/caddy
USER iroha
EXPOSE 8080
