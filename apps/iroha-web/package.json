{
	"name": "iroha-web",
	"private": true,
	"version": "0.1.4",
	"type": "module",
	"scripts": {
		"sync-assets": "bun ../../scripts/sync-iroha-assets.ts iroha-web",
		"predev": "bun run sync-assets",
		"dev": "vite dev",
		"prebuild": "bun run sync-assets",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "bun run sync-assets && (svelte-kit sync || echo '')",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "vitest run"
	},
	"overrides": {
		"cookie": "0.7.0",
		"nanoid": "3.3.18",
		"postcss": "8.5.26",
		"vite": "8.2.2"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/vite": "4.3.3",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.56.10",
		"svelte-check": "^4.7.6",
		"tailwindcss": "4.3.3",
		"typescript": "^6.0.3",
		"vite": "^8.2.2",
		"vitest": "^4.1.11"
	},
	"dependencies": {
		"@lucide/svelte": "^1.34.0",
		"echarts": "^6.1.0",
		"maplibre-gl": "^6.6.0",
		"uplot": "^1.6.32"
	}
}
