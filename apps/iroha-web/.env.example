# Base URL of the iroha-server read API. Defaults to http://127.0.0.1:8080
# when unset. Copy this file to .env to override.
PUBLIC_IROHA_API_BASE=http://127.0.0.1:8080
# IANA timezone used for local calendar scopes. Keep it equal to IROHA_TIMEZONE
# in iroha-server when the web app uses a separately built static bundle.
PUBLIC_IROHA_TIMEZONE=Asia/Tokyo
