# Base URL of the iroha-server read API. Defaults to same-origin through the
# Vite /api + /public proxy when unset. Copy this file to .env to override.
PUBLIC_IROHA_API_BASE=http://127.0.0.1:8080

# Base URL of the PostgREST spike API. Defaults to same-origin through the
# Vite /_postgrest proxy when unset.
PUBLIC_IROHA_POSTGREST_BASE=http://127.0.0.1:3001
